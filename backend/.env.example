APP_NAME=FINN API
ENVIRONMENT=development
SUPABASE_URL=
# Must be the Supabase project's SERVICE ROLE key, not the anon/public key.
# migrations/006's own grants (match_document_chunks) are issued to `service_role`
# only — the anon role cannot execute it, and writes to tables without a
# permissive anon policy would also fail. Treat this as a secret: never commit
# it, never log it, set it only via the hosting platform's secret store.
SUPABASE_KEY=
LOG_LEVEL=INFO
# Production only: a JSON array of allowed frontend origins. pydantic-settings
# parses this automatically (no code change needed) — e.g. for the deployed
# Vercel frontend:
# CORS_ALLOW_ORIGINS=["https://finn-enam-rho.vercel.app","http://localhost:3000"]
# Defaults to localhost-only if unset — a deployed frontend will get CORS
# errors in the browser until this is set.
CORS_ALLOW_ORIGINS=
MARKET_DATA_EOD_WINDOW_DAYS=20
DATA_DIR=data
ANTHROPIC_API_KEY=
CLASSIFICATION_LLM_CONFIDENCE_THRESHOLD=0.6
DEFAULT_VOLUME_SPIKE_MULTIPLE=2.0
DEFAULT_PRICE_MOVE_PCT=5.0
DEFAULT_DIGEST_WINDOW_HOURS=24

# Embeddings (Phase 3 / RAG): local-only by design, no paid API or key required.
# all-MiniLM-L6-v2 (384-dim) runs on-device via sentence-transformers, downloaded
# once from Hugging Face on first use and cached locally after that.
EMBEDDING_PROVIDER=local_minilm

# Phase 12A: scheduled EOD market-data refresh.
# ADMIN_API_TOKEN gates /api/admin/* — those routes refuse all requests (503) until
# this is set to a real secret.
ADMIN_API_TOKEN=
ENABLE_MARKET_DATA_SCHEDULER=false
MARKET_DATA_REFRESH_CRON=0 18 * * 1-5

# Phase 12B: automatic document discovery.
ENABLE_DOCUMENT_DISCOVERY_SCHEDULER=false
DOCUMENT_DISCOVERY_CRON=30 19 * * 1-5
DOCUMENT_DISCOVERY_MAX_NEW_DOCS_PER_COMPANY=6
DOCUMENT_DISCOVERY_LOOKBACK_QUARTERS=4

# Phase 12C: automatic announcement discovery.
ENABLE_ANNOUNCEMENT_DISCOVERY_SCHEDULER=false
ANNOUNCEMENT_DISCOVERY_CRON=0 17 * * 1-5
