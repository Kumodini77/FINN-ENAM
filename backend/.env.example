# Embeddings (Phase 3 / RAG): local-only by design, no paid API or key required.
# all-MiniLM-L6-v2 (384-dim) runs on-device via sentence-transformers, downloaded
# once from Hugging Face on first use and cached locally after that.
EMBEDDING_PROVIDER=local_minilm
